{
  "name": "trialguard",
  "private": true,
  "type": "module",
  "workspaces": ["packages/core", "apps/api", "apps/web"],
  "scripts": {
    "dev": "npm run dev -w @trialguard/api & npm run dev -w @trialguard/web",
    "start": "npm run build -w @trialguard/web && npm run start -w @trialguard/api",
    "test": "node --test 'packages/*/test/*.test.ts' 'apps/api/test/*.test.ts'",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm run typecheck -w @trialguard/web"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0"
  },
  "engines": { "node": ">=22.18" }
}
